  "manifest_contract": {
    "relative_path": "{mod_id}.json",
    "expected": {
      "id": "{mod_id}",
      "name": "{mod_id}",
      "author": "User",
      "description": "Slay the Spire 2 mod created from a template for use with BaseLib",
      "version": "v0.0.0",
      "has_pck": true,
      "has_dll": true,
      "min_game_version": "0.107.1",
      "dependencies": [
        {"id": "BaseLib", "min_version": "v3.3.8"}
      ],
      "affects_gameplay": true
    }
  },
  "build_recipe": {
    "local_properties": [
      {"input_key": "game_assembly", "property": "Sts2AssemblyPath"},
      {"input_key": "godot_executable", "property": "GodotPath"}
    ],
    "steps": [
      {"id": "publish", "runner": "dotnet_publish"}
    ]
  },
  "package_layout": {
    "required_files": [
      "BaseLib/BaseLib.dll",
      "BaseLib/BaseLib.pck",
      "BaseLib/BaseLib.json",
      "{mod_id}/{mod_id}.dll",
      "{mod_id}/{mod_id}.pck",
      "{mod_id}/{mod_id}.json"
    ]
