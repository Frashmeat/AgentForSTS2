{
  "schemaVersion": 3,
  "id": "sts2",
  "displayName": "Slay the Spire 2",
  "itemTypes": [
    {
      "id": "custom_code",
      "displayNames": { "eng": "Custom code", "zhs": "自定义代码" },
      "requiredLocales": [],
      "fields": [],
      "evidenceQueries": [
        { "symbols": ["ICustomModel"], "terms": [] }
      ],
      "requiredResourceRoles": []
    },
    {
      "id": "relic",
      "displayNames": { "eng": "Relic", "zhs": "遗物" },
      "requiredLocales": ["eng", "zhs"],
      "fields": [
        {
          "id": "rarity",
          "displayNames": { "eng": "Rarity", "zhs": "稀有度" },
          "required": true,
          "value": {
            "kind": "choice",
            "options": [
              { "value": "common", "displayNames": { "eng": "Common", "zhs": "普通" } },
              { "value": "uncommon", "displayNames": { "eng": "Uncommon", "zhs": "罕见" } },
              { "value": "rare", "displayNames": { "eng": "Rare", "zhs": "稀有" } },
              { "value": "boss", "displayNames": { "eng": "Boss", "zhs": "Boss" } },
              { "value": "shop", "displayNames": { "eng": "Shop", "zhs": "商店" } },
              { "value": "starter", "displayNames": { "eng": "Starter", "zhs": "初始" } }
            ]
          }
        }
      ],
      "evidenceQueries": [
        { "symbols": ["CustomRelicModel"], "terms": [] },
        { "symbols": ["CustomContentDictionary.AddModel"], "terms": [] },
        { "symbols": ["RelicModel"], "terms": [] }
      ],
      "requiredResourceRoles": ["relic.normal", "relic.outline", "relic.big"]
    }
  ],
  "contributions": [
    {
      "slotId": "project.create.template",
      "featureId": "project.create",
      "schema": { "id": "pack.project-template", "version": 1 },
      "requiredPrimitives": ["storage.project-template"],
      "payload": { "templateId": "sts2.default" }
    },
    {
      "slotId": "mod.plan.guidance",
      "featureId": "mod.plan",
      "schema": { "id": "pack.mod-plan-guidance", "version": 3 },
      "payload": {
        "guidance": [
          "Plan one independently testable Mod item at a time.",
          "Describe behavior intent and acceptance criteria without inventing lifecycle hook names.",
          "When behavior depends on game APIs, require pinned Truth Evidence during generation."
        ]
      }
    },
    {
      "slotId": "mod.generate.single",
      "featureId": "mod.generate.single",
      "schema": { "id": "pack.mod-generate-single", "version": 3 },
      "requiredPrimitives": ["code.dotnet-validate"],
      "payload": {
        "validationPrimitive": "code.dotnet-validate",
        "guidance": [
          "Generate complete C# source files that compile in the active project.",
          "Use only API and lifecycle symbols supported by the supplied Truth Evidence.",
          "Do not emit binary resources, project files, build commands, or paths outside declared file roles."
        ],
        "itemTypes": [
          {
            "id": "custom_code",
            "generatedFiles": [
              { "role": "source", "targetPath": "Generated/{item_id}.cs" }
            ]
          },
          {
            "id": "relic",
            "generatedFiles": [
              { "role": "source", "targetPath": "Generated/{item_id}.cs" },
              { "role": "localization.eng", "targetPath": "{mod_id}/localization/eng/relics.json" },
              { "role": "localization.zhs", "targetPath": "{mod_id}/localization/zhs/relics.json" }
            ]
          }
        ]
      }
    },
    {
      "slotId": "mod.generate.batch",
      "featureId": "mod.generate.batch",
      "schema": { "id": "pack.mod-generate-batch", "version": 1 },
      "payload": { "compose": "mod.generate.single" }
    },
    {
      "slotId": "mod.generate.complex",
      "featureId": "mod.generate.complex",
      "schema": { "id": "pack.mod-generate-complex", "version": 1 },
      "payload": { "compose": "mod.generate.batch" }
    },
    {
      "slotId": "log.analyze.rules",
      "featureId": "log.analyze",
      "schema": { "id": "pack.log-rules", "version": 1 },
      "requiredPrimitives": ["log.dotnet-parser"],
      "payload": {
        "ecosystems": [
          {
            "label": ".NET compiler",
            "indicators": ["CS0246", "CS0103", "CS1061", "namespace", "type or namespace name"],
            "interpretations": [
              "A compiler diagnostic is normally downstream of a missing reference, incompatible API version, or incorrect namespace.",
              "Use the first compiler error as the primary signal because later errors may be cascading failures."
            ],
            "checks": [
              "Compare referenced API symbols with the pinned Truth Snapshot.",
              "Confirm the project targets the framework version required by the installed mod toolchain."
            ]
          },
          {
            "label": "MSBuild and dotnet publish",
            "indicators": ["MSB", "dotnet publish", "Copy", "ResolveAssemblyReference", "project.assets.json"],
            "interpretations": [
              "Restore, reference resolution, compilation, and publish are distinct stages; identify the earliest failing target.",
              "A publish failure can occur after compilation succeeds and should not be reported as a source-code failure."
            ],
            "checks": [
              "Identify the failing target and task before proposing a project-file change.",
              "Check output and dependency paths without exposing absolute user paths."
            ]
          },
          {
            "label": "Godot runtime",
            "indicators": ["Godot", "SCRIPT ERROR", "Node", "ResourceLoader", "res://"],
            "interpretations": [
              "Runtime resource or node errors are separate from managed compilation and packaging failures.",
              "The first engine error generally has more diagnostic value than repeated follow-on stack entries."
            ],
            "checks": [
              "Verify the packaged resource path and case exactly match the runtime reference.",
              "Distinguish engine startup failures from mod initialization failures."
            ]
          },
          {
            "label": "BaseLib mod lifecycle",
            "indicators": ["BaseLib", "ModInitializer", "LoadMods", "Harmony", "patch"],
            "interpretations": [
              "A mod can compile and publish successfully but fail during discovery, initialization, or patch application.",
              "Lifecycle ordering and API compatibility must be supported by pinned Truth Evidence."
            ],
            "checks": [
              "Locate the earliest mod discovery or initialization failure.",
              "Compare lifecycle symbols and hook signatures with the selected Truth Snapshot."
            ]
          }
        ],
        "priorities": [
          "Report the earliest actionable root cause before cascading symptoms.",
          "Separate build, publish, package, game startup, and mod initialization stages.",
          "Mark an explanation as a hypothesis when the supplied log and Truth Evidence do not prove it."
        ]
      }
    },
    {
      "slotId": "resource.prepare.specs",
      "featureId": "resource.prepare",
      "schema": { "id": "pack.resource-specs", "version": 2 },
      "requiredPrimitives": ["image.role-transform"],
      "payload": {
        "roles": [
          {
            "id": "relic.master",
            "mediaTypes": ["image/png"],
            "width": 512,
            "height": 512,
            "requireAlpha": true,
            "source": { "kind": "master" }
          },
          {
            "id": "relic.normal",
            "mediaTypes": ["image/png"],
            "width": 128,
            "height": 128,
            "requireAlpha": true,
            "targetPath": "{mod_id}/images/relics/{item_id}.png",
            "source": {
              "kind": "derived",
              "sourceRole": "relic.master",
              "transform": {
                "operation": "resize",
                "primitive": "image.role-transform",
                "version": 1
              }
            }
          },
          {
            "id": "relic.outline",
            "mediaTypes": ["image/png"],
            "width": 128,
            "height": 128,
            "requireAlpha": true,
            "targetPath": "{mod_id}/images/relics/{item_id}_outline.png",
            "source": {
              "kind": "derived",
              "sourceRole": "relic.master",
              "transform": {
                "operation": "outline",
                "primitive": "image.role-transform",
                "version": 1,
                "radius": 4
              }
            }
          },
          {
            "id": "relic.big",
            "mediaTypes": ["image/png"],
            "width": 256,
            "height": 256,
            "requireAlpha": true,
            "targetPath": "{mod_id}/images/relics/{item_id}_big.png",
            "source": {
              "kind": "derived",
              "sourceRole": "relic.master",
              "transform": {
                "operation": "resize",
                "primitive": "image.role-transform",
                "version": 1
              }
            }
          }
        ]
      }
    },
    {
      "slotId": "project.build.recipe",
      "featureId": "project.build",
      "schema": { "id": "pack.build-recipe", "version": 1 },
      "requiredPrimitives": ["process.dotnet-publish"],
      "payload": {
        "steps": [
          { "id": "publish", "primitive": "process.dotnet-publish" }
        ]
      }
    },
    {
      "slotId": "project.package.layout",
      "featureId": "project.package",
      "schema": { "id": "pack.package-layout", "version": 1 },
      "payload": {
        "requiredFiles": [
          "BaseLib/BaseLib.dll",
          "BaseLib/BaseLib.pck",
          "BaseLib/BaseLib.json",
          "{mod_id}/{mod_id}.dll",
          "{mod_id}/{mod_id}.pck",
          "{mod_id}/{mod_id}.json"
        ]
      }
    }
  ]
}
